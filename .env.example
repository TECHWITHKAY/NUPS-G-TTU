# Environment Variables Template
# Copy this to .env and fill in your values (local development only).
# On Render these are injected automatically (especially DATABASE_URL).

# --- Local PostgreSQL connection (used only when DATABASE_URL is NOT set) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=your_password_here
DB_NAME=nupsg_church

# --- Render PostgreSQL (leave commented locally; Render sets DATABASE_URL) ---
# DATABASE_URL=postgres://user:password@host:5432/nupsg_church

# Site Configuration
SITE_NAME=NUPS-G Church
# Public URL of the site - used for links inside notification emails
SITE_URL=http://localhost
ADMIN_EMAIL=sethsefa18@gmail.com

# --- Paystack payments (donations) ---
# Get keys at https://dashboard.paystack.com -> Settings -> API Keys & Webhooks.
# Use TEST keys (sk_test_... / pk_test_...) while developing, LIVE keys (sk_live_...) in production.
# When PAYSTACK_SECRET_KEY is empty, the donate page uses the manual "giving intent" flow instead.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Currency for Paystack charges - Ghana uses GHS
PAYSTACK_CURRENCY=GHS

# --- Outbound email (newsletter notifications) ---
# Fill these in so subscribers actually receive event/blog emails.
# Example for Gmail:  MAIL_HOST=smtp.gmail.com  MAIL_PORT=587  MAIL_SECURE=tls
#                     MAIL_USER=<your@gmail.com>  MAIL_PASS=<16-character App Password>
# Leave MAIL_HOST empty to fall back to PHP mail() (works on most shared hosts).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=tls
MAIL_USER=sethsefa18@gmail.com
MAIL_PASS=your_16_character_app_password_here
# The address notifications are sent FROM (use the church's own mailbox so replies land there)
MAIL_FROM=sethsefa18@gmail.com

# Optional: your WhatsApp group invite link (e.g. https://chat.whatsapp.com/AbCdEf...).
# When set, the "Share Quiz" buttons open this group directly; leave empty to
# open the WhatsApp share picker instead so users choose a chat/group themselves.
WHATSAPP_GROUP_URL=

# Application environment: development | production
APP_ENV=development
